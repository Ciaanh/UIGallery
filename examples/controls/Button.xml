<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
	<!-- @snippet button-icon -->
	<Button name="UIGalleryIconButtonTemplate" mixin="UIGalleryIconButtonMixin" virtual="true">
		<Size x="40" y="40"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true">
					<TexCoords left="0.07" right="0.93" top="0.07" bottom="0.93"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Flash" alpha="0" alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight" setAllPoints="true">
					<Animations>
						<AnimationGroup parentKey="Anim">
							<Alpha fromAlpha="1" toAlpha="0" duration="0.3"/>
						</AnimationGroup>
					</Animations>
				</Texture>
			</Layer>
		</Layers>
		<PushedTexture file="Interface\Buttons\UI-Quickslot-Depress"/>
		<HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
		<Scripts>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnClick method="OnClick"/>
		</Scripts>
	</Button>
	<!-- @end -->
</Ui>
