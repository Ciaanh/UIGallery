<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
	<!-- @snippet cooldown-action -->
	<!-- The three cooldowns of Blizzard's ActionButtonTemplate, on a bare icon. -->
	<Frame name="UIGalleryActionCooldownsTemplate" virtual="true">
		<Size x="64" y="64"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Icon" file="Interface\Icons\Spell_Nature_Lightning" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Frames>
			<!-- The spell's cooldown: dark swipe, countdown numbers, no edge. -->
			<Cooldown parentKey="Cooldown" inherits="CooldownFrameTemplate" drawBling="false" drawEdge="false" useParentLevel="true">
				<SwipeTexture>
					<Color r="0" g="0" b="0" a="0.64"/>
				</SwipeTexture>
			</Cooldown>
			<!-- Loss of control (stun, silence): red swipe and Blizzard's red edge. -->
			<Cooldown parentKey="LossOfControl" inherits="CooldownFrameTemplate" drawBling="false" hideCountdownNumbers="true" useParentLevel="true">
				<SwipeTexture>
					<Color r="0.17" g="0" b="0" a="0.64"/>
				</SwipeTexture>
				<EdgeTexture file="Interface\Cooldown\UI-HUD-ActionBar-LoC"/>
			</Cooldown>
			<!-- Recharging charge: edge only, the icon stays usable. -->
			<Cooldown parentKey="Charge" inherits="CooldownFrameTemplate" drawSwipe="false" hideCountdownNumbers="true" useParentLevel="true"/>
		</Frames>
	</Frame>
	<!-- @end -->
</Ui>
